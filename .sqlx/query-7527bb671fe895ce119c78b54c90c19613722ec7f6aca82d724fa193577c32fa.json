  "query": "SELECT c.id, c.name, c.color, c.icon\n           FROM collection_files cf\n           JOIN collections c ON c.id = cf.collection_id AND c.owner_id = $1\n           WHERE cf.owner_id = $1 AND cf.file_id = $2\n           ORDER BY lower(c.name), c.id",
