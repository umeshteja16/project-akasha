  "query": "SELECT id, owner_id, title, file_ids, created_at, updated_at FROM conversations\n         WHERE owner_id = $1\n           AND ($2::timestamptz IS NULL OR (updated_at, id) < ($2, $3::uuid))\n         ORDER BY updated_at DESC, id DESC\n         LIMIT $4",
