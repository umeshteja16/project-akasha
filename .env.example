# Copy to .env and adjust. `just` loads .env automatically.
DATABASE_URL=postgres://akasha:akasha@localhost:5432/akasha
AKASHA_BIND_ADDR=0.0.0.0:8080
AKASHA_LOG_FORMAT=pretty   # pretty | json
AKASHA_DB_MAX_CONNECTIONS=10
RUST_LOG=info,tower_http=info,sqlx=warn
AKASHA_COOKIE_SECURE=false        # true in production (behind HTTPS)
AKASHA_TRUSTED_PROXIES=           # reverse proxies to believe X-Forwarded-For from, e.g. 127.0.0.1,10.0.0.0/8 (README)
AKASHA_ALLOW_REGISTRATION=true
AKASHA_SESSION_TTL_DAYS=30
AKASHA_ACTIVITY_RETENTION_DAYS=365 # activity + security log kept this long, 0 = forever
AKASHA_MAX_UPLOAD_MB=512          # largest accepted upload
AKASHA_WATCH_ROOTS=               # folders users may watch (Settings → Sources), comma-separated; empty = off
AKASHA_WATCH_SCAN_MINUTES=15      # full rescan of watched folders (0 = only on file events)
AKASHA_WATCH_FS_EVENTS=true       # pick up changes within seconds (inotify)
AKASHA_METRICS_ENABLED=false      # Prometheus metrics (README "Monitoring")
AKASHA_METRICS_BIND_ADDR=         # e.g. 0.0.0.0:9090: separate, unauthenticated listener (keep private)
AKASHA_METRICS_TOKEN=             # else /metrics on the main port needs this bearer token
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # export traces (OTLP/HTTP)
AKASHA_STORAGE_BACKEND=local      # local | s3
AKASHA_STORAGE_DIR=./storage      # local backend root
# S3 / S3-compatible (MinIO, R2, ...). Keys fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# AKASHA_STORAGE_S3_BUCKET=akasha
# AKASHA_STORAGE_S3_REGION=us-east-1
# AKASHA_STORAGE_S3_ENDPOINT=http://localhost:9000
# AKASHA_STORAGE_S3_ACCESS_KEY_ID=
# AKASHA_STORAGE_S3_SECRET_ACCESS_KEY=
# AKASHA_STORAGE_S3_ALLOW_HTTP=false
AKASHA_SERVE_WITH_WORKER=false    # `serve` also runs the background worker (single box)
AKASHA_WORKER_CONCURRENCY=4       # jobs run at once per worker
AKASHA_WORKER_POLL_SECS=5         # fallback poll; new jobs wake workers via LISTEN/NOTIFY
AKASHA_WORKER_VISIBILITY_TIMEOUT_SECS=300  # lost-worker detection
AKASHA_WORKER_SHUTDOWN_GRACE_SECS=30       # time for in-flight jobs on shutdown
AKASHA_OCR_ENABLED=true           # OCR images and scanned PDF pages (ocrs, pure Rust)
AKASHA_MODELS_DIR=./models        # model files (OCR ~12 MB, embedding/rerank ~0.6 GB), fetched on first use
# AKASHA_OCR_MODELS_URL=          # empty = never download (offline: copy the .rten files in yourself)
# Audio/video transcription (ADR 0017): whisper.cpp, model downloaded via AKASHA_ML_MODELS_URL
AKASHA_TRANSCRIBE_ENABLED=true    # false: recordings stay playable without text
AKASHA_WHISPER_MODEL=base         # tiny | base | small | medium | large-v3-turbo (multilingual)
# AKASHA_TRANSCRIBE_THREADS=0     # CPU threads per transcription, 0 = cores (max 8)
# AKASHA_TRANSCRIBE_MAX_MINUTES=120  # longer recordings: only the start is transcribed
# AKASHA_TRANSCRIBE_LANGUAGE=     # ISO 639-1 (en, de, ...); empty = detect
# Embeddings and reranking (ADR 0009). Need ONNX Runtime: `just onnxruntime`, then:
AKASHA_ORT_DYLIB_PATH=./models/onnxruntime/libonnxruntime.so
AKASHA_EMBED_MODEL=multilingual-e5-small  # changing it later needs `akasha reembed`
AKASHA_RERANK_MODEL=jina-reranker-v1-turbo-en  # or `none`
# AKASHA_ML_MODELS_URL=https://huggingface.co  # empty = never download (air-gapped)
# AKASHA_ML_THREADS=0             # inference threads per model, 0 = all cores
AKASHA_SEARCH_RATE_PER_MINUTE=30 # searches per user per minute, 0 = unlimited
# AKASHA_SEARCH_MIN_SIMILARITY=  # relevance floor for vector-only results; empty = per-model default
# AKASHA_SEARCH_MIN_RERANK_SCORE= # same, by reranker score when reranking; empty = per-reranker default
# Grounded chat (ADR 0012). Provider: ollama (local, default) | anthropic | gemini | openai | none
AKASHA_LLM_PROVIDER=ollama
# AKASHA_LLM_MODEL=               # empty = provider default (llama3.1:8b, claude-sonnet-5-5, gemini-2.5-flash)
AKASHA_OLLAMA_URL=http://localhost:11434
# AKASHA_OLLAMA_NUM_CTX=8192      # context window requested from Ollama
# AKASHA_STRICT_OFFLINE=false     # true: refuse to start with a cloud provider / non-local server
# AKASHA_ANTHROPIC_API_KEY=       # falls back to ANTHROPIC_API_KEY
# AKASHA_ANTHROPIC_EFFORT=low     # Claude output_config.effort; empty = model default
# AKASHA_GEMINI_API_KEY=          # falls back to GEMINI_API_KEY (sent as a header, never in URLs)
# AKASHA_OPENAI_BASE_URL=http://localhost:1234/v1  # any OpenAI-compatible server (LM Studio, vLLM, llama.cpp)
# AKASHA_OPENAI_API_KEY=          # falls back to OPENAI_API_KEY; optional for local servers
# AKASHA_LLM_MAX_TOKENS=1024      # longest answer
# AKASHA_LLM_READ_TIMEOUT_SECS=120  # give up after this long without new output
# AKASHA_LLM_MAX_RETRIES=2        # on connection errors, 429 and 5xx (before output starts)
# AKASHA_LLM_ENRICH_FILES=true   # summary + suggested tags per file after indexing (one model call per file)
# AKASHA_LLM_CONVERSATION_TITLES=true  # model-written conversation titles after the first answer
AKASHA_CHAT_RATE_PER_MINUTE=20    # questions per user per minute, 0 = unlimited
# AKASHA_CHAT_CONTEXT_CHUNKS=8    # passages given to the model per answer
# AKASHA_CHAT_HISTORY_MESSAGES=6  # earlier messages sent along with a question
# AKASHA_CHAT_CONDENSE_QUESTION=true  # rewrite follow-ups into standalone search queries
# AKASHA_CHAT_MIN_RERANK_SCORE=   # refusal threshold; empty = calibrated default per reranker
