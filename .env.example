# Copy to .env and adjust. `just` loads .env automatically.
DATABASE_URL=postgres://akasha:akasha@localhost:5432/akasha
AKASHA_BIND_ADDR=0.0.0.0:8080
AKASHA_LOG_FORMAT=pretty   # pretty | json
AKASHA_DB_MAX_CONNECTIONS=10
RUST_LOG=info,tower_http=info,sqlx=warn
AKASHA_COOKIE_SECURE=false        # true in production (behind HTTPS)
AKASHA_ALLOW_REGISTRATION=true
AKASHA_SESSION_TTL_DAYS=30
AKASHA_MAX_UPLOAD_MB=512          # largest accepted upload
AKASHA_STORAGE_BACKEND=local      # local | s3
AKASHA_STORAGE_DIR=./storage      # local backend root
# S3 / S3-compatible (MinIO, R2, ...). Keys fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# AKASHA_STORAGE_S3_BUCKET=akasha
# AKASHA_STORAGE_S3_REGION=us-east-1
# AKASHA_STORAGE_S3_ENDPOINT=http://localhost:9000
# AKASHA_STORAGE_S3_ACCESS_KEY_ID=
# AKASHA_STORAGE_S3_SECRET_ACCESS_KEY=
# AKASHA_STORAGE_S3_ALLOW_HTTP=false
AKASHA_SERVE_WITH_WORKER=false    # `serve` also runs the background worker (single box)
AKASHA_WORKER_CONCURRENCY=4       # jobs run at once per worker
AKASHA_WORKER_POLL_SECS=5         # fallback poll; new jobs wake workers via LISTEN/NOTIFY
AKASHA_WORKER_VISIBILITY_TIMEOUT_SECS=300  # lost-worker detection
AKASHA_WORKER_SHUTDOWN_GRACE_SECS=30       # time for in-flight jobs on shutdown
AKASHA_OCR_ENABLED=true           # OCR images and scanned PDF pages (ocrs, pure Rust)
AKASHA_MODELS_DIR=./models        # model files (OCR ~12 MB, embedding/rerank ~0.6 GB), fetched on first use
# AKASHA_OCR_MODELS_URL=          # empty = never download (offline: copy the .rten files in yourself)
# Embeddings and reranking (ADR 0009). Need ONNX Runtime: `just onnxruntime`, then:
AKASHA_ORT_DYLIB_PATH=./models/onnxruntime/libonnxruntime.so
AKASHA_EMBED_MODEL=multilingual-e5-small  # changing it later needs `akasha reembed`
AKASHA_RERANK_MODEL=jina-reranker-v1-turbo-en  # or `none`
# AKASHA_ML_MODELS_URL=https://huggingface.co  # empty = never download (air-gapped)
# AKASHA_ML_THREADS=0             # inference threads per model, 0 = all cores
AKASHA_SEARCH_RATE_PER_MINUTE=30 # searches per user per minute, 0 = unlimited
