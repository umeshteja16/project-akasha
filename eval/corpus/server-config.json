{
  "service": "notes-api",
  "listen": { "host": "0.0.0.0", "port": 8443, "tls": true },
  "database": { "pool_size": 20, "statement_timeout_ms": 5000 },
  "cache": { "backend": "redis", "ttl_seconds": 300 },
  "logging": { "level": "info", "format": "json" },
  "features": { "signup_enabled": false, "maintenance_banner": "Planned maintenance on Sunday night" }
}
