  "components": {
    "schemas": {
      "BulkDeleteRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Up to 100 file ids. Ids that are unknown (or not yours) are ignored."
          }
        }
      },
      "BulkDeleteResponse": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ids that were deleted."
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "Current password, to confirm."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. `not_found`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExtractionResponse": {
        "type": "object",
        "required": [
          "file_id",
          "extractor",
          "extractor_version",
          "char_count",
          "chunk_count",
          "pages",
          "notes",
          "offset",
          "text",
          "created_at"
        ],
        "properties": {
          "char_count": {
            "type": "integer",
            "format": "int32",
            "description": "Length of the whole text in characters."
          },
          "chunk_count": {
            "type": "integer",
            "format": "int64",
            "description": "Chunks indexed for search."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "extractor": {
            "type": "string",
            "description": "`text`, `markdown`, `csv`, `json`, `pdf`, `ocr`, or `none` when nothing could be\nextracted (e.g. audio and video, which are not transcribed yet)."
          },
          "extractor_version": {
            "type": "string"
          },
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Pass as `offset` to read on; `null` at the end."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Remarks such as \"OCR is disabled\" or \"truncated\"."
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Character offset of `text` in the whole text."
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Pages in the document; `null` for formats without pages."
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageSpan"
            },
            "description": "Page spans, in order (PDFs only)."
          },
          "text": {
            "type": "string",
            "description": "The requested window of the text."
          }
        }
      },
      "FileCategory": {
        "type": "string",
        "description": "Broad file kind, for filtering.",
        "enum": [
          "pdf",
          "image",
          "audio",
          "video",
          "text"
        ]
      },
      "FileDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FileResponse"
          },
          {
            "type": "object",
            "properties": {
              "processing": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ProcessingJob",
                    "description": "Latest extraction job, if one was ever queued."
                  }
                ]
              }
            }
          }
        ],
        "description": "One file plus the state of its latest extraction job."
      },
      "FileList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileResponse"
            },
            "description": "Newest first."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` to get the next page; `null` on the last page."
          }
        }
      },
      "FileResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mime_type",
          "size_bytes",
          "content_hash",
          "status",
          "is_pinned",
          "tags",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "content_hash": {
            "type": "string",
            "description": "SHA-256 of the contents, lowercase hex."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why processing failed, when `status` is `failed`."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_pinned": {
            "type": "boolean"
          },
          "mime_type": {
            "type": "string",
            "description": "Detected from the contents, not taken from the client."
          },
          "name": {
            "type": "string",
            "description": "Sanitised original filename."
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/FileStatus"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FileStatus": {
        "type": "string",
        "description": "Processing state of a file.",
        "enum": [
          "pending",
          "processing",
          "ready",
          "failed"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "JobState": {
        "type": "string",
        "description": "State of a background job.",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "dead"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PageSource": {
        "type": "string",
        "description": "Where a PDF page's text came from.",
        "enum": [
          "text",
          "ocr",
          "needs_ocr",
          "unreadable"
        ]
      },
      "PageSpan": {
        "type": "object",
        "description": "A PDF page's span in the full text (`char_start..char_end`, in characters).",
        "required": [
          "number",
          "char_start",
          "char_end",
          "source"
        ],
        "properties": {
          "char_end": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "char_start": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "number": {
            "type": "integer",
            "format": "int32",
            "description": "1-based page number.",
            "minimum": 0
          },
          "source": {
            "$ref": "#/components/schemas/PageSource"
          }
        }
      },
      "ProcessingJob": {
        "type": "object",
        "required": [
          "state",
          "attempts",
          "max_attempts",
          "updated_at"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32",
            "description": "Attempts started so far."
          },
          "max_attempts": {
            "type": "integer",
            "format": "int32"
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it will next be tried (`queued` or `failed` only)."
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UpdateFileRequest": {
        "type": "object",
        "properties": {
          "is_pinned": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "New display name (sanitised like uploads)."
          },
          "tags": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Replaces all tags. Trimmed and lowercased; at most 32, each 1–50 characters."
          }
        }
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "New display name; `null` or blank clears it."
          }
        }
      },
      "UploadForm": {
        "type": "object",
        "description": "`multipart/form-data` body of an upload.",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The file. Its type is detected from the bytes; the filename is sanitised."
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "akasha_session"
      }
    }
  }
}
